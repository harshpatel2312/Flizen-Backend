# Firebase Configuration
FIREBASE_CREDENTIALS_PATH=firebase-admin-key.json
FIREBASE_PROJECT_ID=flizen-flight-booking

# CORS Configuration (comma-separated list)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:3001

# Environment
ENVIRONMENT=development

# Duffel API Configuration
# Get your access token from: https://duffel.com/
# Create an account, create an app, and copy your access token
DUFFEL_ACCESS_TOKEN=YOUR_DUFFEL_ACCESS_TOKEN_HERE

# Stripe Configuration
# From https://dashboard.stripe.com/apikeys — use the SECRET (sk_...) key, not publishable.
STRIPE_SECRET_KEY=YOUR_STRIPE_SECRET_KEY_HERE
# Signing secret for the /webhooks/stripe endpoint (set once webhook route is added).
STRIPE_WEBHOOK_SECRET=YOUR_STRIPE_WEBHOOK_SECRET_HERE

# Frontend URL — used for Stripe return_url / redirect flows.
FRONTEND_URL=http://localhost:5173
