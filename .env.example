# Firebase Configuration
FIREBASE_CREDENTIALS_PATH=firebase-admin-key.json
FIREBASE_PROJECT_ID=flizen-flight-booking

# CORS Configuration (comma-separated list)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:3001

# Environment
ENVIRONMENT=development

# Duffel API Configuration
# Get your access token from: https://duffel.com/
# Create an account, create an app, and copy your access token
DUFFEL_ACCESS_TOKEN=YOUR_DUFFEL_ACCESS_TOKEN_HERE
